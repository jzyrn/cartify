# Mailtrap Email Sandbox (captured in your sandbox inbox; not delivered to customers)
# Copy the sandbox SMTP values from Email Sandbox > Integrations > SMTP.
NODE_ENV=production
DB_LOCAL_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7
FRONTEND_URL=https://your-frontend.onrender.com
FIREBASE_API_KEY=your_firebase_web_api_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_mailtrap_sandbox_username
SMTP_PASSWORD=your_mailtrap_sandbox_password
SMTP_FROM_NAME=Cartify
SMTP_FROM_EMAIL=receipts@cartify.test
