# Mailtrap Email API/SMTP (Transactional Stream)
# Copy these values to backend/config/.env and replace the placeholders.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_EMAIL=api
SMTP_PASSWORD=your_mailtrap_smtp_token
SMTP_FROM_NAME=Cartify
# Must use an email address on a domain verified in Mailtrap.
SMTP_FROM_EMAIL=receipts@your-verified-domain.com
